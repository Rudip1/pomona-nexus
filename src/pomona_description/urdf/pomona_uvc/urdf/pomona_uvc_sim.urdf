             points down (joint below), so the lens points down at the bed -->
      <origin rpy="1.5708 0 1.5708" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://pomona_description/meshes/sensors/d455.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.124 0.029 0.026"/>
      </geometry>
    </collision>
  </link>
  <joint name="uvc_cam_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="uvc_cam_left_link"/>
    <!-- panel FRONT edge (+X), over the bed centre (side*panel_y_c), just below
           the panel; pitched +90 so the sensor looks straight down at the bed -->
    <origin rpy="0 1.5708 0" xyz="0.53 1.0 0.74"/>
  </joint>
  <!-- REP-103 optical frame (Z forward, X right, Y down) for published images -->
  <link name="uvc_cam_left_optical_frame"/>
  <joint name="uvc_cam_left_optical_joint" type="fixed">
    <parent link="uvc_cam_left_link"/>
    <child link="uvc_cam_left_optical_frame"/>
    <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0"/>
  </joint>
  <link name="uvc_cam_right_link">
    <visual>
      <!-- official RealSense d455.stl orientation (rpy pi/2,0,pi/2); link +X
             points down (joint below), so the lens points down at the bed -->
      <origin rpy="1.5708 0 1.5708" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://pomona_description/meshes/sensors/d455.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.124 0.029 0.026"/>
      </geometry>
    </collision>
  </link>
  <joint name="uvc_cam_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="uvc_cam_right_link"/>
    <!-- panel FRONT edge (+X), over the bed centre (side*panel_y_c), just below
           the panel; pitched +90 so the sensor looks straight down at the bed -->
    <origin rpy="0 1.5708 0" xyz="0.53 -1.0 0.74"/>
  </joint>
  <!-- REP-103 optical frame (Z forward, X right, Y down) for published images -->
  <link name="uvc_cam_right_optical_frame"/>
  <joint name="uvc_cam_right_optical_joint" type="fixed">
    <parent link="uvc_cam_right_link"/>
    <child link="uvc_cam_right_optical_frame"/>
    <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0"/>
  </joint>
  <!-- ════════════════════════════════════════════════════════════════════
       1. Robosense LiDAR (frame = rslidar)
       The real unit sits at the FRONT of the mounting box, not floating
       above the base centre. Mounted on box_link with the original
       laser_Link transform from scout_xarm_base (xyz 0.37655 0 0.003).
       Low (~0.351 m AGL) on purpose: the single 2D plane then clips the
       0.40 m bed side-walls so the furrows map as corridors. (We tried a
       raised central 3D lidar, but its downward rings scanned the robot's
       own rear display as a phantom obstacle — reverted to this 2D mount.)
       Visual uses the ported laser_link mesh; collision is a cheap cylinder.
       ════════════════════════════════════════════════════════════════════ -->
  <link name="rslidar">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://pomona_description/meshes/mount/laser_link.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <cylinder length="0.09" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00029458 -1.102E-05 0.035775"/>
      <mass value="0.58508"/>
      <inertia ixx="0.00062907" ixy="-3.4247E-08" ixz="6.994E-08" iyy="0.00063026" iyz="-4.8147E-08" izz="0.00074925"/>
    </inertial>
  </link>
  <joint name="rslidar_joint" type="fixed">
    <parent link="box_link"/>
    <child link="rslidar"/>
    <origin rpy="0 0 0" xyz="0.37655 0 0.003"/>
  </joint>
  <!-- ════════════════════════════════════════════════════════════════════
       2. Xsens MTi IMU (mounted on base_link)
       Approximate placement; refine when validating against bag data.
       ════════════════════════════════════════════════════════════════════ -->
  <link name="imu_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.035 0.057 0.022"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.035 0.057 0.022"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.5554166666666668e-05" ixy="0" ixz="0" iyy="7.120833333333334e-06" iyz="0" izz="1.864166666666667e-05"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0.32 0 0.18"/>
  </joint>
  <!-- NOTE (pomona_uvc): the D435 was mounted on the xArm6 EE (link_eef),
       which is removed in this model, so the camera is omitted. -->
  <!-- ════════════════════════════════════════════════════════════════════
       Scout V2 skid-steer differential drive
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="scout_diff_drive">
      <ros>
        <namespace>/</namespace>
      </ros>
      <!-- Two wheels per side → must declare 2 pairs, else the plugin
           aborts with "Inconsistent number of joints specified". -->
      <num_wheel_pairs>2</num_wheel_pairs>
      <!-- Left side wheels (front_left + rear_left) -->
      <left_joint>front_left_wheel</left_joint>
      <left_joint>rear_left_wheel</left_joint>
      <!-- Right side wheels (front_right + rear_right) -->
      <right_joint>front_right_wheel</right_joint>
      <right_joint>rear_right_wheel</right_joint>
      <!-- ONE value per wheel pair (num_wheel_pairs=2). If only listed once,
           pair 2 (rear wheels) silently falls back to the plugin default
           (0.34 m / 0.2 m), so the rear axle turns with a different differential
           than the front and the same-side wheels fight each other. Both pairs
           share the Scout's track + wheel size, so repeat the same values. -->
      <wheel_separation>0.58306</wheel_separation>
      <wheel_separation>0.58306</wheel_separation>
      <wheel_diameter>0.32918</wheel_diameter>
      <wheel_diameter>0.32918</wheel_diameter>
      <max_wheel_torque>50.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <update_rate>50.0</update_rate>
    </plugin>
    <!-- Wheel joint states. The diff_drive plugin spins the wheels in Gazebo
         but does NOT publish their joint positions, and the wheels are not part
         of ros2_control. Without this, robot_state_publisher has no angle for
         the 4 continuous wheel joints and the wheels float at the origin in
         RViz. pomona_original needs the same plugin (wheels only — disjoint
         from joint_state_broadcaster, which covers arm+gripper, so no race). -->
    <plugin filename="libgazebo_ros_joint_state_publisher.so" name="wheel_joint_state">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>front_left_wheel</joint_name>
      <joint_name>front_right_wheel</joint_name>
      <joint_name>rear_left_wheel</joint_name>
      <joint_name>rear_right_wheel</joint_name>
    </plugin>
  </gazebo>
  <!-- ════════════════════════════════════════════════════════════════════
       Robosense LiDAR — 360° 2D plane (publishes /scan_raw via ray_sensor)
       A laser_self_filter node (pomona_state_publisher_uvc.launch.py) drops the
       self-returns (the low plane clips the rear display) and republishes /scan,
       so the robot body reads as free space, not a phantom obstacle. Full 360°
       is kept — no angular trim — because the filter is geometric, not by angle.
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="rslidar">
    <!-- gpu_ray (not CPU "ray"): the CPU ray path (ODEMultiRayShape) segfaults
         in dSpaceCollide2 when gzserver has no rendering context — which is the
         case here since the UVC model has no camera. gpu_ray renders the scan
         instead of ODE-raycasting, sidestepping the crash (and is faster). -->
    <sensor name="rslidar" type="gpu_ray">
      <always_on>true</always_on>
      <!-- viz OFF so the lidar's blue ray fan doesn't clash with the UV-C ray
           fans (Gazebo Classic hardcodes laser colour → can't recolour either).
           The lidar still publishes /scan; view it in RViz to recolour it. -->
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- 0.1 m: halves the old 0.2 m near-field dead disc (the front-middle
               gap that stayed unexplored as the robot advanced) without pulling
               in so far that the gpu_ray catches the sensor housing / box top
               (0.05 m did). -->
          <min>0.1</min>
          <max>5.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="rslidar_controller">
        <ros>
          <remapping>~/out:=scan_raw</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>rslidar</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- ════════════════════════════════════════════════════════════════════
       Xsens MTi IMU
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_controller">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
  <!-- ════════════════════════════════════════════════════════════════════
       UV-C lamp tubes — emissive violet so the lamps read as ON.
       (URDF <material> is ignored by Gazebo; needs a Gazebo/ script. PurpleGlow
       is an emissive built-in → the tubes glow like energised UV-C lamps.)
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="uvc_lamps_link">
    <material>Gazebo/PurpleGlow</material>
  </gazebo>
  <link name="uvc_emit_left_0_link">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="uvc_emit_left_0_joint" type="fixed">
    <parent link="base_link"/>
    <child link="uvc_emit_left_0_link"/>
    <origin rpy="1.5708 0 0" xyz="-0.21999999999999997 1.0 0.781"/>
  </joint>
  <gazebo reference="uvc_emit_left_0_link">
    <sensor name="uvc_emit_left_0" type="gpu_ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>8</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>15</samples>
            <resolution>1</resolution>
            <min_angle>-1.8326</min_angle>
            <!-- −105° : down-and-back (±15° from straight down, 30° total) -->
            <max_angle>-1.3090</max_angle>
            <!-- −75°  : down-and-fore -->
          </horizontal>
          <vertical>
            <samples>3</samples>
            <resolution>1</resolution>
            <min_angle>-0.17</min_angle>
            <max_angle>0.17</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.01</min>
          <!-- reach the ground: lamp is ~1.02 m AGL straight down; the ±60°
                   edge rays need ~2 m, so the whole fan lands on the floor (in
                   crop worlds it terminates earlier on the beds/plants) -->
          <max>2.2</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>
  <link name="uvc_emit_left_1_link">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
