<?xml version="1.0"?>
<!--
  Copyright 2026 Pravin Oli
  Licensed under the Apache License, Version 2.0.

  Gazebo Classic 11 plugins for Pomona.
  Only included when xacro is processed with `use_sim:=true`.

  Plugins (pomona_uvc has no arm/gripper/camera, so none of those here):
    - libgazebo_ros_diff_drive.so       — Scout V2 skid-steer (4 wheels)
    - libgazebo_ros_ray_sensor.so       — rslidar (gpu_ray) → /scan
    - libgazebo_ros_imu_sensor.so       — Xsens IMU /imu/data
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ════════════════════════════════════════════════════════════════════
       Scout V2 skid-steer differential drive
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="scout_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <!-- Two wheels per side → must declare 2 pairs, else the plugin
           aborts with "Inconsistent number of joints specified". -->
      <num_wheel_pairs>2</num_wheel_pairs>
      <!-- Left side wheels (front_left + rear_left) -->
      <left_joint>front_left_wheel</left_joint>
      <left_joint>rear_left_wheel</left_joint>
      <!-- Right side wheels (front_right + rear_right) -->
      <right_joint>front_right_wheel</right_joint>
      <right_joint>rear_right_wheel</right_joint>

      <!-- ONE value per wheel pair (num_wheel_pairs=2). If only listed once,
           pair 2 (rear wheels) silently falls back to the plugin default
           (0.34 m / 0.2 m), so the rear axle turns with a different differential
           than the front and the same-side wheels fight each other. Both pairs
           share the Scout's track + wheel size, so repeat the same values. -->
      <wheel_separation>0.58306</wheel_separation>
      <wheel_separation>0.58306</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>

      <max_wheel_torque>50.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <update_rate>50.0</update_rate>
    </plugin>

    <!-- Wheel joint states. The diff_drive plugin spins the wheels in Gazebo
         but does NOT publish their joint positions, and the wheels are not part
         of ros2_control. Without this, robot_state_publisher has no angle for
         the 4 continuous wheel joints and the wheels float at the origin in
         RViz. pomona_original needs the same plugin (wheels only — disjoint
         from joint_state_broadcaster, which covers arm+gripper, so no race). -->
    <plugin name="wheel_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>front_left_wheel</joint_name>
      <joint_name>front_right_wheel</joint_name>
      <joint_name>rear_left_wheel</joint_name>
      <joint_name>rear_right_wheel</joint_name>
    </plugin>
  </gazebo>

  <!-- ════════════════════════════════════════════════════════════════════
       Robosense LiDAR — 360° 2D plane (publishes /scan_raw via ray_sensor)
       A laser_self_filter node (pomona_state_publisher_uvc.launch.py) drops the
       self-returns (the low plane clips the rear display) and republishes /scan,
       so the robot body reads as free space, not a phantom obstacle. Full 360°
       is kept — no angular trim — because the filter is geometric, not by angle.
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="rslidar">
    <!-- gpu_ray (not CPU "ray"): the CPU ray path (ODEMultiRayShape) segfaults
         in dSpaceCollide2 when gzserver has no rendering context — which is the
         case here since the UVC model has no camera. gpu_ray renders the scan
         instead of ODE-raycasting, sidestepping the crash (and is faster). -->
    <sensor name="rslidar" type="gpu_ray">
      <always_on>true</always_on>
      <!-- viz OFF so the lidar's blue ray fan doesn't clash with the UV-C ray
           fans (Gazebo Classic hardcodes laser colour → can't recolour either).
           The lidar still publishes /scan; view it in RViz to recolour it. -->
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- 0.1 m: halves the old 0.2 m near-field dead disc (the front-middle
               gap that stayed unexplored as the robot advanced) without pulling
               in so far that the gpu_ray catches the sensor housing / box top
               (0.05 m did). -->
          <min>0.1</min>
          <max>5.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="rslidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan_raw</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>rslidar</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ════════════════════════════════════════════════════════════════════
       Xsens MTi IMU
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ════════════════════════════════════════════════════════════════════
       UV-C lamp tubes — emissive violet so the lamps read as ON.
       (URDF <material> is ignored by Gazebo; needs a Gazebo/ script. PurpleGlow
       is an emissive built-in → the tubes glow like energised UV-C lamps.)
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="uvc_lamps_link">
    <material>Gazebo/PurpleGlow</material>
  </gazebo>

  <!-- ════════════════════════════════════════════════════════════════════
       UV-C emission — a real Gazebo ray fan per lamp tube (visualised like the
       lidar laser). Each gpu_ray is posed at its tube, frame rolled +90° so the
       horizontal scan plane is X-Z (perpendicular to the Y-axis tube). The sweep
       is a NARROW downward arc (≈120°, centred straight down: −150°..−30°) so it
       is ONE render camera — NOT a 360° fan, which builds a 6-camera cube-map and
       (×12 tubes) starved gzserver so the base stopped driving. A thin vertical
       spread gives the fan some thickness along the tube. Rays terminate on the
       panel/flaps + bed/plants → real coverage viz. gpu_ray (not ray) per
       [[gpu-ray-lidar-gotcha]]. NOTE: Classic renders laser rays in fixed
       blue/turquoise — colour is not configurable (lamps glow PurpleGlow above).
       Tune samples / update_rate / uvc_ray_count if FPS drops.
       ════════════════════════════════════════════════════════════════════ -->
  <xacro:property name="uvc_ray_count" value="${n_tubes}"/>   <!-- gpu_ray sensors per side -->
  <!-- fire from the lamp tube centreline so the ray origin sits ON the lamp
       cylinder (the earlier "drop below the flap line" was a workaround for the
       lumping bug below — no longer needed; downward rays clear the shroud) -->
  <xacro:property name="emit_z" value="${lamp_z}"/>
  <!-- CRITICAL: each emitter gets its OWN link, sensor at the link ORIGIN (pose 0).
       Multiple sensors with <pose> offsets on ONE fixed-jointed link get their pose
       DROPPED by gazebo's URDF→SDF fixed-joint lumping (verified: all 12 collapsed
       to base origin, no roll, scanning the wheels at ~0.13 m). Putting the
       position+roll on the JOINT (like rslidar_link) makes lumping bake it in. -->
  <xacro:macro name="uvc_ray_emitter" params="name side i n">
    <xacro:if value="${i &lt; n}">
      <link name="uvc_emit_${name}_${i}_link">
        <inertial>
          <mass value="0.0001"/>
          <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
        </inertial>
      </link>
      <joint name="uvc_emit_${name}_${i}_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="uvc_emit_${name}_${i}_link"/>
        <origin xyz="${panel_x_c - panel_len/2 + tube_inset_x + i*(panel_len - 2*tube_inset_x)/(n-1)} ${side*panel_y_c} ${emit_z}"
                rpy="1.5708 0 0"/>
      </joint>
      <gazebo reference="uvc_emit_${name}_${i}_link">
        <sensor name="uvc_emit_${name}_${i}" type="gpu_ray">
          <pose>0 0 0 0 0 0</pose>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>8</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>15</samples>
                <resolution>1</resolution>
                <min_angle>-1.8326</min_angle>   <!-- −105° : down-and-back (±15° from straight down, 30° total) -->
                <max_angle>-1.3090</max_angle>   <!-- −75°  : down-and-fore -->
              </horizontal>
              <vertical>
                <samples>3</samples>
                <resolution>1</resolution>
                <min_angle>-0.17</min_angle>
                <max_angle>0.17</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.01</min>
              <!-- reach the ground: lamp is ~1.02 m AGL straight down; the ±60°
                   edge rays need ~2 m, so the whole fan lands on the floor (in
                   crop worlds it terminates earlier on the beds/plants) -->
              <max>2.2</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
        </sensor>
      </gazebo>
      <xacro:uvc_ray_emitter name="${name}" side="${side}" i="${i+1}" n="${n}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:uvc_ray_emitter name="left"  side="1"  i="0" n="${uvc_ray_count}"/>
  <xacro:uvc_ray_emitter name="right" side="-1" i="0" n="${uvc_ray_count}"/>
  <!-- NOTE: these blue ray fans are ALWAYS on. Gazebo Classic keeps a visualised
       laser sensor alive via the gzclient visual subscription, so SetActive()
       can't switch them off. The toggleable UV-C signal is the disinfection DOSE
       map (pomona_uvc → /uvc/dose in RViz), driven by /uvc/* services. -->

  <!-- ════════════════════════════════════════════════════════════════════
       RealSense D455 x2 — one per panel, looking down at each bed
       -> /uvc_cam_left/{color,depth}/*  and  /uvc_cam_right/{color,depth}/*
       ════════════════════════════════════════════════════════════════════ -->
  <xacro:macro name="uvc_cam_gazebo" params="name">
    <gazebo reference="uvc_cam_${name}_link">
      <sensor name="uvc_cam_${name}_rgb" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>6.0</far></clip>
        </camera>
        <plugin name="uvc_cam_${name}_rgb_ctrl" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/uvc_cam_${name}</namespace>
            <remapping>image_raw:=color/image_raw</remapping>
            <remapping>camera_info:=color/camera_info</remapping>
          </ros>
          <frame_name>uvc_cam_${name}_optical_frame</frame_name>
        </plugin>
      </sensor>
      <sensor name="uvc_cam_${name}_depth" type="depth">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>
          <image><width>424</width><height>240</height></image>
          <clip><near>0.2</near><far>6.0</far></clip>
        </camera>
        <plugin name="uvc_cam_${name}_depth_ctrl" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/uvc_cam_${name}</namespace>
            <remapping>image_raw:=depth/image_rect_raw</remapping>
            <remapping>camera_info:=depth/camera_info</remapping>
            <remapping>points:=depth/points</remapping>
          </ros>
          <frame_name>uvc_cam_${name}_optical_frame</frame_name>
          <point_cloud_cutoff>0.2</point_cloud_cutoff>
          <point_cloud_cutoff_max>6.0</point_cloud_cutoff_max>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:uvc_cam_gazebo name="left"/>
  <xacro:uvc_cam_gazebo name="right"/>

</robot>
