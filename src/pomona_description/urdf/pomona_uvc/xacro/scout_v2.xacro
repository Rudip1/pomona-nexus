<?xml version="1.0"?>
<!--
  Copyright 2026 Pravin Oli
  Licensed under the Apache License, Version 2.0.

  AgileX Scout V2 mobile base.

  Adapted from agilexrobotics/scout_ros — scout_description/urdf/scout_v2.xacro
  License: BSD-3-Clause (upstream).

  Geometry (from upstream): base 0.925 x 0.380 x 0.210 m,
  wheelbase 0.498 m, track 0.583 m, wheel radius 0.165 m.
-->
<robot name="scout_v2" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find pomona_description)/urdf/pomona_uvc/xacro/scout_wheel_type1.xacro"/>
  <xacro:include filename="$(find pomona_description)/urdf/pomona_uvc/xacro/scout_wheel_type2.xacro"/>

  <!-- Vehicle Geometries -->
  <xacro:property name="base_x_size" value="0.9250"/>
  <xacro:property name="base_y_size" value="0.3800"/>
  <xacro:property name="base_z_size" value="0.2100"/>

  <!-- Stock AgileX Scout V2 geometry (real-robot-accurate; BSD upstream). -->
  <xacro:property name="wheelbase" value="0.498"/>
  <xacro:property name="track"     value="0.58306"/>
  <xacro:property name="wheel_vertical_offset" value="-0.0702"/>

  <xacro:property name="wheel_length_stock" value="1.1653e-01"/>
  <xacro:property name="wheel_radius_stock" value="1.6459e-01"/>

  <!-- ORIGINAL model: wheels at stock size. The sim oversize knob (wheel_scale)
       lives in the pomona_uvc model, not here. -->
  <xacro:property name="wheel_scale"  value="1.0"/>

  <xacro:property name="wheel_length" value="${wheel_length_stock * wheel_scale}"/>
  <xacro:property name="wheel_radius" value="${wheel_radius_stock * wheel_scale}"/>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://pomona_description/meshes/base/base_link.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${base_z_size/6}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x_size/6} ${base_y_size*1.65} ${base_z_size/3}"/>
      </geometry>
    </collision>
  </link>

  <!-- base_footprint is the TF root (on the ground): the Gazebo diff_drive
       plugin publishes odom -> base_footprint, so base_footprint must be the
       parent of base_link. If this joint is inverted (base_link -> footprint),
       base_footprint ends up with two parents (odom + base_link) and the TF
       tree breaks -> slam_toolbox drops every scan ("queue is full"). -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 ${wheel_radius - wheel_vertical_offset}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child  link="base_link"/>
  </joint>

  <link name="inertial_link">
    <inertial>
      <mass value="40"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="2.288641" ixy="0" ixz="0"
               iyy="5.103976" iyz="0"
               izz="3.431465"/>
    </inertial>
  </link>
  <joint name="inertial_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="inertial_link"/>
  </joint>

  <!-- 4 wheels, counter-clockwise from front-right.
       Motors 1 & 2 (left side) are mechanically reversed. -->
  <xacro:scout_wheel_type1 wheel_prefix="front_right" wheel_axis="0 -1 0">
    <origin xyz="${ wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="3.14 0 0"/>
  </xacro:scout_wheel_type1>
  <xacro:scout_wheel_type2 wheel_prefix="front_left">
    <origin xyz="${ wheelbase/2} ${ track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
  </xacro:scout_wheel_type2>
  <xacro:scout_wheel_type1 wheel_prefix="rear_left">
    <origin xyz="${-wheelbase/2} ${ track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
  </xacro:scout_wheel_type1>
  <xacro:scout_wheel_type2 wheel_prefix="rear_right" wheel_axis="0 -1 0">
    <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="3.14 0 0"/>
  </xacro:scout_wheel_type2>

</robot>
