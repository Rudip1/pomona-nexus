<?xml version="1.0"?>
<!--
  Copyright 2026 Pravin Oli
  Licensed under the Apache License, Version 2.0.

  UV-C cantilever (pomona_uvc only) — replaces the xArm6 arm.

  T-frame (front view):

       panel_L                 mast                 panel_R
      [=======]                 |                  [=======]
       | | | |  <- lamps        |          lamps -> | | | |
              \                 |                  /
               +=== cross-tube ===o=== cross-tube ===+   (T-weld at mast top)
                                  |
                                (base/rod on the box)

  A vertical CIRCULAR mast carries one horizontal CIRCULAR cross-tube (same dia),
  T-welded at the top. The cross-tube reaches out to the INNER EDGE of each flat
  panel (weld gusset there); each 1 m-wide panel cantilevers outward over a full
  strawberry bed. Beds are 2 m centre-to-centre; the robot drives the 1 m furrow
  between them.

  Each panel = a shallow housing: flat roof plate + two side shield FLAPS hanging
  down on both long edges (skirt_depth) so the UV-C only projects onto the bed.
  Lamps = n_tubes thin blue glass cylinders running ACROSS the bed (row-wise),
  spread along the driving direction, recessed under the roof.

  A RealSense D455 (official mesh, meshes/sensors/d455.stl) hangs on a small
  L-bracket FORWARD of and below each panel front edge, lens looking straight
  down at its bed -> /uvc_cam_{left,right}/{color,depth}/* (gazebo_plugins.xacro).

  Links: uvc_cantilever_link (mast + cross-tube + gussets + panels + flaps +
  brackets, grey), uvc_lamps_link (tubes only -> coloured blue in Gazebo), and
  uvc_cam_{left,right}_link (D455). Primitives + the D455 mesh; base_link frame.
  Stock wheels -> ground at base_link z = -0.235, so arm_z = 0.80 -> panels
  ~1.08 m AGL. All sizes are the tunables below; after editing, regenerate with
  scripts/xacro_to_urdf.sh (+ gz sdf for models/pomona_uvc/model.sdf).
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ── arm-base mount (kept from xArm6: meshes/arm/base.stl) ──────────── -->
  <link name="uvc_base_link">
    <visual>
      <geometry><mesh filename="package://pomona_description/meshes/arm/base.stl"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://pomona_description/meshes/arm/base.stl"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.09103"/>
      <mass value="2.7"/>
      <inertia ixx="0.00494875" ixy="-3.5E-06" ixz="1.25E-05"
               iyy="0.00494174" iyz="1.67E-06" izz="0.002219"/>
    </inertial>
  </link>
  <joint name="uvc_base_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="uvc_base_link"/>
    <origin xyz="0.212 0 0.26" rpy="0 0 0"/>
  </joint>

  <!-- ── tunables (base_link frame) ────────────────────────────────────── -->
  <xacro:property name="panel_y_c"   value="1.0"/>    <!-- panel centre (bed centre) from centreline -->
  <xacro:property name="panel_width" value="1.0"/>    <!-- panel lateral width (Y) = bed width -->
  <xacro:property name="arm_z"       value="0.80"/>    <!-- panel plane height (~1.08 m AGL (+0.30 m)) -->
  <xacro:property name="panel_len"   value="0.73"/>    <!-- panel fore-aft length (= box length) -->
  <xacro:property name="panel_x_c"   value="0.065"/>   <!-- panel fore-aft centre (= box centre) -->
  <xacro:property name="panel_thick" value="0.012"/>   <!-- panel thickness (Z) — thin flat plate -->
  <xacro:property name="rod_x"       value="0.065"/>   <!-- mast at box/panel fore-aft centre (= panel_x_c); cross-tube now welds each panel at the MIDPOINT of its inner edge. (Was 0.212 over the arm base, which welded 0.147 m forward of centre; the arm-base mesh at 0.212 is now the lidar pedestal.) -->
  <xacro:property name="rod_z_bot"   value="0.28"/>
  <xacro:property name="rod_radius"  value="0.025"/>   <!-- circular mast + cross-tube radius -->

  <!-- T-frame: a single horizontal CIRCULAR cross-tube (same dia as the mast)
       welded to the mast top, reaching out to the INNER EDGE of each panel.
       Panels cantilever outward from that inner-edge weld (not the centre). -->
  <xacro:property name="panel_inner" value="${panel_y_c - panel_width/2}"/>  <!-- inner long edge (0.5) -->
  <xacro:property name="panel_front_x" value="${panel_x_c + panel_len/2}"/>  <!-- leading (front) edge in +X -->

  <!-- D455 camera: on an L-bracket FORWARD of the panel front edge, hanging
       below it, lens looking straight down at the bed (clear of the lamps) -->
  <xacro:property name="cam_scale" value="0.001"/>   <!-- D455 STL is in mm -->
  <xacro:property name="cam_fwd"   value="0.10"/>    <!-- forward of the panel front edge -->
  <xacro:property name="cam_drop"  value="0.06"/>    <!-- 6 cm drop -->

  <!-- UV-C lamps: thin cylindrical glass tubes running ACROSS the bed (row-wise),
       several spread along the driving direction, recessed in a shallow housing -->
  <xacro:property name="tube_radius"  value="0.009"/>  <!-- ~18 mm dia glass tube (realistic) -->
  <xacro:property name="n_tubes"      value="6"/>      <!-- lamps per panel -->
  <xacro:property name="tube_len"     value="${panel_width - 0.10}"/>  <!-- across bed, inside the flaps -->
  <xacro:property name="tube_inset_x" value="0.08"/>   <!-- keep end lamps inside the panel ends -->
  <xacro:property name="skirt_depth"  value="0.18"/>   <!-- side flap hang-down (shields stray rays) -->
  <xacro:property name="flap_thick"   value="0.006"/>  <!-- thin shield plate -->
  <xacro:property name="lamp_z" value="${arm_z - panel_thick/2 - tube_radius - 0.004}"/>

  <!-- UV-C emission: rendered by per-tube gpu_ray sensor fans (see
       gazebo_plugins.xacro) — a downward laser fan out of each lamp tube, like
       a lidar scan, terminating on the bed/plants. beam_h = lamp-to-bed drop
       sets the ray range. Bed top is 0.40 m AGL; base_link sits 0.235 m AGL →
       bed top = 0.165 in base_link. -->
  <xacro:property name="bed_top_z" value="0.165"/>
  <xacro:property name="beam_h"  value="${lamp_z - bed_top_z}"/>

  <!-- housing for one side: flat roof plate + two thin side flaps (skirts) that
       hang down on both long edges so the UV-C only projects onto the bed -->
  <xacro:macro name="uvc_panel" params="name side">
    <visual name="${name}_panel">
      <origin xyz="${panel_x_c} ${side*panel_y_c} ${arm_z}" rpy="0 0 0"/>
      <geometry><box size="${panel_len} ${panel_width} ${panel_thick}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision name="${name}_panel_collision">
      <origin xyz="${panel_x_c} ${side*panel_y_c} ${arm_z}" rpy="0 0 0"/>
      <geometry><box size="${panel_len} ${panel_width} ${panel_thick}"/></geometry>
    </collision>
    <!-- inner-edge shield flap -->
    <visual name="${name}_flap_in">
      <origin xyz="${panel_x_c} ${side*(panel_y_c - panel_width/2)} ${arm_z - skirt_depth/2}" rpy="0 0 0"/>
      <geometry><box size="${panel_len} ${flap_thick} ${skirt_depth}"/></geometry>
      <material name="grey"/>
    </visual>
    <!-- outer-edge shield flap -->
    <visual name="${name}_flap_out">
      <origin xyz="${panel_x_c} ${side*(panel_y_c + panel_width/2)} ${arm_z - skirt_depth/2}" rpy="0 0 0"/>
      <geometry><box size="${panel_len} ${flap_thick} ${skirt_depth}"/></geometry>
      <material name="grey"/>
    </visual>
  </xacro:macro>

  <!-- recursive: place n cross-bed (row-wise) glass tubes spread along +X -->
  <xacro:macro name="uvc_tube_row" params="name side i n">
    <xacro:if value="${i &lt; n}">
      <visual name="uvc_lamp_${name}_${i}">
        <origin xyz="${panel_x_c - panel_len/2 + tube_inset_x + i*(panel_len - 2*tube_inset_x)/(n-1)} ${side*panel_y_c} ${lamp_z}"
                rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${tube_radius}" length="${tube_len}"/></geometry>
        <material name="uvc_violet"/>
      </visual>
      <xacro:uvc_tube_row name="${name}" side="${side}" i="${i+1}" n="${n}"/>
    </xacro:if>
  </xacro:macro>

  <!-- n row-wise tubes + one collision box, for one side -->
  <xacro:macro name="uvc_lamp_side" params="name side">
    <xacro:uvc_tube_row name="${name}" side="${side}" i="0" n="${n_tubes}"/>
    <collision name="uvc_lamp_${name}_collision">
      <origin xyz="${panel_x_c} ${side*panel_y_c} ${lamp_z}" rpy="0 0 0"/>
      <geometry><box size="${panel_len} ${tube_len} ${2*tube_radius}"/></geometry>
    </collision>
  </xacro:macro>

  <!-- ── frame link: rod + cross-arm + flat panels ─────────────────────── -->
  <link name="uvc_cantilever_link">
    <visual name="uvc_rod">
      <origin xyz="${rod_x} 0 ${(rod_z_bot + arm_z)/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${rod_radius}" length="${arm_z - rod_z_bot}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision name="uvc_rod_collision">
      <origin xyz="${rod_x} 0 ${(rod_z_bot + arm_z)/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${rod_radius}" length="${arm_z - rod_z_bot}"/></geometry>
    </collision>

    <!-- horizontal CIRCULAR cross-tube, T-welded to mast top, reaching to each
         panel's inner edge (cylinder axis along Y -> roll 90 deg) -->
    <visual name="uvc_cross_tube">
      <origin xyz="${rod_x} 0 ${arm_z}" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="${rod_radius}" length="${2*panel_inner}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision name="uvc_cross_tube_collision">
      <origin xyz="${rod_x} 0 ${arm_z}" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="${rod_radius}" length="${2*panel_inner}"/></geometry>
    </collision>

    <xacro:uvc_panel name="left"  side="1"/>
    <xacro:uvc_panel name="right" side="-1"/>

    <!-- weld collars/gussets: a tapered block at each tube-to-panel inner-edge
         joint, bridging the fat round tube to the thin flat panel -->
    <xacro:macro name="uvc_weld" params="side">
      <visual name="uvc_weld_${side}">
        <origin xyz="${rod_x} ${side*panel_inner} ${arm_z}" rpy="0 0 0"/>
        <geometry><box size="0.09 0.07 ${2*rod_radius + panel_thick}"/></geometry>
        <material name="grey"/>
      </visual>
      <collision name="uvc_weld_${side}_collision">
        <origin xyz="${rod_x} ${side*panel_inner} ${arm_z}" rpy="0 0 0"/>
        <geometry><box size="0.09 0.07 ${2*rod_radius + panel_thick}"/></geometry>
      </collision>
    </xacro:macro>
    <xacro:uvc_weld side="1"/>
    <xacro:uvc_weld side="-1"/>

    <!-- camera L-bracket: a forward arm from the panel front edge, then a drop
         down to the D455 (so the camera hangs forward & below, lens down) -->
    <xacro:macro name="uvc_cam_bracket" params="side">
      <visual name="cam_arm_${side}">
        <origin xyz="${panel_front_x + cam_fwd/2} ${side*panel_y_c} ${arm_z - 0.012}" rpy="0 0 0"/>
        <geometry><box size="${cam_fwd + 0.02} 0.025 0.02"/></geometry>
        <material name="grey"/>
      </visual>
      <visual name="cam_drop_${side}">
        <origin xyz="${panel_front_x + cam_fwd} ${side*panel_y_c} ${arm_z - cam_drop/2}" rpy="0 0 0"/>
        <geometry><box size="0.025 0.025 ${cam_drop}"/></geometry>
        <material name="grey"/>
      </visual>
    </xacro:macro>
    <xacro:uvc_cam_bracket side="1"/>
    <xacro:uvc_cam_bracket side="-1"/>

    <inertial>
      <origin xyz="${rod_x} 0 ${arm_z}" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.90" ixy="0" ixz="0" iyy="0.20" iyz="0" izz="1.0"/>
    </inertial>
  </link>
  <joint name="uvc_cantilever_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="uvc_cantilever_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ── lamps link: the UV-C tubes only (Gazebo colours these blue) ─────── -->
  <link name="uvc_lamps_link">
    <xacro:uvc_lamp_side name="left"  side="1"/>
    <xacro:uvc_lamp_side name="right" side="-1"/>
    <inertial>
      <origin xyz="${panel_x_c} 0 ${lamp_z}" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.06" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.07"/>
    </inertial>
  </link>
  <joint name="uvc_lamps_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="uvc_lamps_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- UV-C emission is rendered by gpu_ray sensors on uvc_lamps_link
       (gazebo_plugins.xacro) — a downward laser fan per lamp tube. -->

  <!-- ── RealSense D455 (real mesh), on the FRONT EDGE of each panel, facing
       down at the bed. Link frame is pitched +90 so the Gazebo camera sensor's
       +X axis looks straight down; the mesh is rolled so its lens faces down and
       its long axis runs across the bed (Y). ── -->
  <xacro:macro name="uvc_camera" params="name side">
    <link name="uvc_cam_${name}_link">
      <visual>
        <!-- official RealSense d455.stl orientation (rpy pi/2,0,pi/2); link +X
             points down (joint below), so the lens points down at the bed -->
        <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
        <geometry>
          <mesh filename="package://pomona_description/meshes/sensors/d455.stl"
                scale="${cam_scale} ${cam_scale} ${cam_scale}"/>
        </geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><box size="0.124 0.029 0.026"/></geometry>
      </collision>
    </link>
    <joint name="uvc_cam_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="uvc_cam_${name}_link"/>
      <!-- panel FRONT edge (+X), over the bed centre (side*panel_y_c), just below
           the panel; pitched +90 so the sensor looks straight down at the bed -->
      <origin xyz="${panel_front_x + cam_fwd} ${side*panel_y_c} ${arm_z - cam_drop}" rpy="0 1.5708 0"/>
    </joint>
    <!-- REP-103 optical frame (Z forward, X right, Y down) for published images -->
    <link name="uvc_cam_${name}_optical_frame"/>
    <joint name="uvc_cam_${name}_optical_joint" type="fixed">
      <parent link="uvc_cam_${name}_link"/>
      <child  link="uvc_cam_${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>
  </xacro:macro>
  <xacro:uvc_camera name="left"  side="1"/>
  <xacro:uvc_camera name="right" side="-1"/>

</robot>
