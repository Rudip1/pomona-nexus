<?xml version="1.0"?>
<!--
  Copyright 2026 Pravin Oli
  Licensed under the Apache License, Version 2.0.

  Gazebo Classic 11 plugins for Pomona.
  Only included when xacro is processed with `use_sim:=true`.

  Plugins:
    - libgazebo_ros_diff_drive.so       — Scout V2 skid-steer (4 wheels)
    - libgazebo_ros_joint_state_publisher.so — joint_states for the 4 wheels
                                               (arm+gripper come from ros2_control)
    - libgazebo_ros_ray_sensor.so       — rslidar (gpu_ray) → /scan
    - libgazebo_ros_camera.so           — D435 RGB + depth
    - libgazebo_ros_imu_sensor.so       — Xsens IMU /imu/data
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ════════════════════════════════════════════════════════════════════
       Scout V2 skid-steer differential drive
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="scout_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <!-- Two wheels per side → must declare 2 pairs, else the plugin
           aborts with "Inconsistent number of joints specified". -->
      <num_wheel_pairs>2</num_wheel_pairs>
      <!-- Left side wheels (front_left + rear_left) -->
      <left_joint>front_left_wheel</left_joint>
      <left_joint>rear_left_wheel</left_joint>
      <!-- Right side wheels (front_right + rear_right) -->
      <right_joint>front_right_wheel</right_joint>
      <right_joint>rear_right_wheel</right_joint>

      <!-- ONE value per wheel pair (num_wheel_pairs=2). If only listed once,
           pair 2 (rear wheels) silently falls back to the plugin default
           (0.34 m / 0.2 m), so the rear axle turns with a different differential
           than the front and the same-side wheels fight each other. Both pairs
           share the Scout's track + wheel size, so repeat the same values. -->
      <wheel_separation>0.58306</wheel_separation>
      <wheel_separation>0.58306</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>

      <max_wheel_torque>50.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <update_rate>50.0</update_rate>
    </plugin>

    <!-- arm/gripper joint_states come from joint_state_broadcaster
         (ros2_control.xacro). The wheels are NOT in ros2_control and the
         diff_drive plugin doesn't publish their positions, so they need their
         own publisher or robot_state_publisher can't place them (wheels float
         at the origin in RViz). Listing ONLY the 4 wheels keeps this disjoint
         from the broadcaster (arm+gripper) — no two publishers on one joint. -->
    <plugin name="wheel_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>front_left_wheel</joint_name>
      <joint_name>front_right_wheel</joint_name>
      <joint_name>rear_left_wheel</joint_name>
      <joint_name>rear_right_wheel</joint_name>
    </plugin>
  </gazebo>

  <!-- ════════════════════════════════════════════════════════════════════
       Robosense LiDAR (publishes /scan via ray_sensor)
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="rslidar">
    <!-- gpu_ray (not CPU "ray"): the CPU ray path (ODEMultiRayShape) can segfault
         in dSpaceCollide2 when gzserver has no rendering context. Here the D435
         camera happens to provide one, but gpu_ray is the robust choice (renders
         the scan instead of ODE-raycasting) and is faster. -->
    <sensor name="rslidar" type="gpu_ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <!-- 240 deg forward arc (NOT full 360): the lidar sits embedded low
                 inside box_link (front wall 0.07 m ahead, sides 0.16 m -> both
                 within the 0.2 m min_range, so ignored), but the REAR of the box
                 + display panel are >0.2 m back and would otherwise be mapped as
                 a rectangle trailing the robot. Trimming the rear ~120 deg drops
                 those self-returns while keeping the low plane. (Proper 360 deg
                 needs a mast-mounted/3D lidar.) -->
            <samples>600</samples>
            <resolution>1</resolution>
            <min_angle>-2.10</min_angle>
            <max_angle>2.10</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>5.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="rslidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>rslidar</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ════════════════════════════════════════════════════════════════════
       Xsens MTi IMU
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ════════════════════════════════════════════════════════════════════
       Intel RealSense D435 — RGB camera
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="camera_link">
    <sensor name="d435_rgb" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.211</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>10.0</far></clip>
      </camera>
      <plugin name="d435_rgb_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <remapping>image_raw:=color/image_raw</remapping>
          <remapping>camera_info:=color/camera_info</remapping>
        </ros>
        <frame_name>camera_color_optical_frame</frame_name>
      </plugin>
    </sensor>

    <!-- D435 depth camera (low-res for sim performance) -->
    <sensor name="d435_depth" type="depth">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.487</horizontal_fov>
        <image>
          <width>424</width>
          <height>240</height>
        </image>
        <clip><near>0.3</near><far>5.0</far></clip>
      </camera>
      <plugin name="d435_depth_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <remapping>image_raw:=depth/image_rect_raw</remapping>
          <remapping>camera_info:=depth/camera_info</remapping>
          <remapping>points:=depth/points</remapping>
        </ros>
        <frame_name>camera_depth_optical_frame</frame_name>
        <point_cloud_cutoff>0.3</point_cloud_cutoff>
        <point_cloud_cutoff_max>5.0</point_cloud_cutoff_max>
      </plugin>
    </sensor>
  </gazebo>

</robot>
