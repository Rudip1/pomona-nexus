<?xml version="1.0"?>
<!--
  Copyright 2026 Pravin Oli
  Licensed under the Apache License, Version 2.0.

  DH Robotics AG95 two-finger gripper.

  Adapted from DH Robotics dh_robotics_ag95_model (BSD-3-Clause, upstream).
  Simplified for day-1: one driver joint (finger_joint), three mimic joints
  per finger. Real hardware mimic ratios preserved.

  Mount point: link "${prefix}dh_robotics_ag95_base_link" — attach this to
  xArm6 link_eef in the root xacro.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ── BASE LINK ─────────────────────────────────────────────────────── -->
  <xacro:macro name="ag95_base_link" params="prefix">
    <link name="${prefix}dh_robotics_ag95_base_link">
      <visual>
        <geometry><mesh filename="package://pomona_description/meshes/gripper/base_link.STL"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://pomona_description/meshes/gripper/base_link.STL"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0.05"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ── Per-finger link macros ───────────────────────────────────────── -->
  <xacro:macro name="ag95_finger_links" params="prefix fingerprefix">
    <link name="${prefix}${fingerprefix}_crank">
      <visual><geometry><mesh filename="package://pomona_description/meshes/gripper/link_crank.STL"/></geometry><material name="dark"/></visual>
      <collision><geometry><mesh filename="package://pomona_description/meshes/gripper/link_crank.STL"/></geometry></collision>
      <inertial><mass value="0.0085"/><origin xyz="0 0.0199 0.0292"/><inertia ixx="2.9e-06" ixy="0" ixz="0" iyy="1.9e-06" iyz="-1.2e-06" izz="1.2e-06"/></inertial>
    </link>
    <link name="${prefix}${fingerprefix}_rod">
      <visual><geometry><mesh filename="package://pomona_description/meshes/gripper/link_rod.STL"/></geometry><material name="dark"/></visual>
      <collision><geometry><mesh filename="package://pomona_description/meshes/gripper/link_rod.STL"/></geometry></collision>
      <inertial><mass value="0.0226"/><origin xyz="0 0.0374 -0.0208"/><inertia ixx="1.5e-05" ixy="0" ixz="0" iyy="6.2e-06" iyz="6.8e-06" izz="1.2e-05"/></inertial>
    </link>
    <link name="${prefix}${fingerprefix}_proximal_phalanx">
      <visual><geometry><mesh filename="package://pomona_description/meshes/gripper/link_proximal_phalanx.STL"/></geometry><material name="dark"/></visual>
      <collision><geometry><mesh filename="package://pomona_description/meshes/gripper/link_proximal_phalanx.STL"/></geometry></collision>
      <inertial><mass value="0.0271"/><origin xyz="0 0.0508 0.001"/><inertia ixx="2.6e-05" ixy="-2.4e-07" ixz="0" iyy="2.8e-06" iyz="-5.4e-07" izz="2.8e-05"/></inertial>
    </link>
    <link name="${prefix}${fingerprefix}_distal_phalanx">
      <visual><geometry><mesh filename="package://pomona_description/meshes/gripper/link_distal_phalanx.STL"/></geometry><material name="silver"/></visual>
      <collision><geometry><mesh filename="package://pomona_description/meshes/gripper/link_distal_phalanx.STL"/></geometry></collision>
      <inertial><mass value="0.0104"/><origin xyz="0 0.016 -0.0137"/><inertia ixx="2.7e-06" ixy="0" ixz="0" iyy="7.7e-07" iyz="6.7e-07" izz="2.3e-06"/></inertial>
    </link>
  </xacro:macro>

  <!-- ── Per-finger joint macros (mimic to finger_joint) ─────────────── -->
  <xacro:macro name="ag95_finger_joints" params="prefix fingerprefix reflect">
    <joint name="${prefix}${fingerprefix}_proximal_phalanx_joint" type="revolute">
      <origin xyz="0 ${reflect*-0.016} 0.10586" rpy="-0.801 0 ${(1 + reflect)*M_PI/2}"/>
      <parent link="${prefix}dh_robotics_ag95_base_link"/>
      <child  link="${prefix}${fingerprefix}_proximal_phalanx"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.8757" velocity="1.0" effort="1000"/>
      <mimic joint="${prefix}finger_joint" multiplier="1.451855" offset="0"/>
    </joint>
    <joint name="${prefix}${fingerprefix}_rod_joint" type="revolute">
      <origin xyz="0 0.037 0" rpy="0.29795 0 0"/>
      <parent link="${prefix}${fingerprefix}_crank"/>
      <child  link="${prefix}${fingerprefix}_rod"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1" upper="0" velocity="1.0" effort="1000"/>
      <mimic joint="${prefix}finger_joint" multiplier="0.4563942" offset="0"/>
    </joint>
    <joint name="${prefix}${fingerprefix}_distal_phalanx_joint" type="revolute">
      <origin xyz="0 0 0.06083" rpy="0.0132645 0 0"/>
      <parent link="${prefix}${fingerprefix}_rod"/>
      <child  link="${prefix}${fingerprefix}_distal_phalanx"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1" upper="0" velocity="1.0" effort="1000"/>
      <mimic joint="${prefix}finger_joint" multiplier="-1.4563851" offset="0"/>
    </joint>
  </xacro:macro>

  <!-- ── Full gripper macro: instantiates everything ───────────────────── -->
  <xacro:macro name="ag95_gripper" params="prefix">
    <xacro:ag95_base_link prefix="${prefix}"/>
    <xacro:ag95_finger_links prefix="${prefix}" fingerprefix="left"/>
    <xacro:ag95_finger_links prefix="${prefix}" fingerprefix="right"/>

    <!-- Driver joint: left crank rotation (everything else mimics this) -->
    <joint name="${prefix}finger_joint" type="revolute">
      <origin xyz="0 0.016 0.10586" rpy="-0.6523 0 0"/>
      <parent link="${prefix}dh_robotics_ag95_base_link"/>
      <child  link="${prefix}left_crank"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.6524" velocity="1.0" effort="1000"/>
    </joint>
    <xacro:ag95_finger_joints prefix="${prefix}" fingerprefix="left" reflect="-1.0"/>

    <!-- Right crank mimics finger_joint -->
    <joint name="${prefix}right_crank_joint" type="revolute">
      <origin xyz="0 -0.016 0.10586" rpy="-0.6523 0 ${M_PI}"/>
      <parent link="${prefix}dh_robotics_ag95_base_link"/>
      <child  link="${prefix}right_crank"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.6524" velocity="1.0" effort="1000"/>
      <mimic joint="${prefix}finger_joint" multiplier="1" offset="0"/>
    </joint>
    <xacro:ag95_finger_joints prefix="${prefix}" fingerprefix="right" reflect="1.0"/>
  </xacro:macro>

</robot>
