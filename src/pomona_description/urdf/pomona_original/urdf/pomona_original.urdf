      <inertia ixx="2.9e-06" ixy="0" ixz="0" iyy="1.9e-06" iyz="-1.2e-06" izz="1.2e-06"/>
    </inertial>
  </link>
  <link name="right_rod">
    <visual>
      <geometry>
        <mesh filename="package://pomona_description/meshes/gripper/link_rod.STL"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://pomona_description/meshes/gripper/link_rod.STL"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0226"/>
      <origin xyz="0 0.0374 -0.0208"/>
      <inertia ixx="1.5e-05" ixy="0" ixz="0" iyy="6.2e-06" iyz="6.8e-06" izz="1.2e-05"/>
    </inertial>
  </link>
  <link name="right_proximal_phalanx">
    <visual>
      <geometry>
        <mesh filename="package://pomona_description/meshes/gripper/link_proximal_phalanx.STL"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://pomona_description/meshes/gripper/link_proximal_phalanx.STL"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0271"/>
      <origin xyz="0 0.0508 0.001"/>
      <inertia ixx="2.6e-05" ixy="-2.4e-07" ixz="0" iyy="2.8e-06" iyz="-5.4e-07" izz="2.8e-05"/>
    </inertial>
  </link>
  <link name="right_distal_phalanx">
    <visual>
      <geometry>
        <mesh filename="package://pomona_description/meshes/gripper/link_distal_phalanx.STL"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://pomona_description/meshes/gripper/link_distal_phalanx.STL"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0104"/>
      <origin xyz="0 0.016 -0.0137"/>
      <inertia ixx="2.7e-06" ixy="0" ixz="0" iyy="7.7e-07" iyz="6.7e-07" izz="2.3e-06"/>
    </inertial>
  </link>
  <!-- Driver joint: left crank rotation (everything else mimics this) -->
  <joint name="finger_joint" type="revolute">
    <origin rpy="-0.6523 0 0" xyz="0 0.016 0.10586"/>
    <parent link="dh_robotics_ag95_base_link"/>
    <child link="left_crank"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="0" upper="0.6524" velocity="1.0"/>
  </joint>
  <joint name="left_proximal_phalanx_joint" type="revolute">
    <origin rpy="-0.801 0 0.0" xyz="0 0.016 0.10586"/>
    <parent link="dh_robotics_ag95_base_link"/>
    <child link="left_proximal_phalanx"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="0" upper="0.8757" velocity="1.0"/>
    <mimic joint="finger_joint" multiplier="1.451855" offset="0"/>
  </joint>
  <joint name="left_rod_joint" type="revolute">
    <origin rpy="0.29795 0 0" xyz="0 0.037 0"/>
    <parent link="left_crank"/>
    <child link="left_rod"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-1" upper="0" velocity="1.0"/>
    <mimic joint="finger_joint" multiplier="0.4563942" offset="0"/>
  </joint>
  <joint name="left_distal_phalanx_joint" type="revolute">
    <origin rpy="0.0132645 0 0" xyz="0 0 0.06083"/>
    <parent link="left_rod"/>
    <child link="left_distal_phalanx"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-1" upper="0" velocity="1.0"/>
    <mimic joint="finger_joint" multiplier="-1.4563851" offset="0"/>
  </joint>
  <!-- Right crank mimics finger_joint -->
  <joint name="right_crank_joint" type="revolute">
    <origin rpy="-0.6523 0 3.14159" xyz="0 -0.016 0.10586"/>
    <parent link="dh_robotics_ag95_base_link"/>
    <child link="right_crank"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="0" upper="0.6524" velocity="1.0"/>
    <mimic joint="finger_joint" multiplier="1" offset="0"/>
  </joint>
  <joint name="right_proximal_phalanx_joint" type="revolute">
    <origin rpy="-0.801 0 3.14159" xyz="0 -0.016 0.10586"/>
    <parent link="dh_robotics_ag95_base_link"/>
    <child link="right_proximal_phalanx"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="0" upper="0.8757" velocity="1.0"/>
    <mimic joint="finger_joint" multiplier="1.451855" offset="0"/>
  </joint>
  <joint name="right_rod_joint" type="revolute">
    <origin rpy="0.29795 0 0" xyz="0 0.037 0"/>
    <parent link="right_crank"/>
    <child link="right_rod"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-1" upper="0" velocity="1.0"/>
    <mimic joint="finger_joint" multiplier="0.4563942" offset="0"/>
  </joint>
  <joint name="right_distal_phalanx_joint" type="revolute">
    <origin rpy="0.0132645 0 0" xyz="0 0 0.06083"/>
    <parent link="right_rod"/>
    <child link="right_distal_phalanx"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="-1" upper="0" velocity="1.0"/>
    <mimic joint="finger_joint" multiplier="-1.4563851" offset="0"/>
  </joint>
  <!-- Attach AG95 base to xArm6 end-effector -->
  <joint name="gripper_mount_joint" type="fixed">
    <parent link="link_eef"/>
    <child link="dh_robotics_ag95_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ════════════════════════════════════════════════════════════════════
       1. Robosense LiDAR (frame = rslidar)
       The real unit sits at the FRONT of the mounting box, not floating
       above the base centre. Mounted on box_link with the original
       laser_Link transform from scout_xarm_base (xyz 0.37655 0 0.003).
       Visual uses the ported laser_link mesh; collision is a cheap cylinder.
       ════════════════════════════════════════════════════════════════════ -->
  <link name="rslidar">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://pomona_description/meshes/mount/laser_link.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <geometry>
        <cylinder length="0.09" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00029458 -1.102E-05 0.035775"/>
      <mass value="0.58508"/>
      <inertia ixx="0.00062907" ixy="-3.4247E-08" ixz="6.994E-08" iyy="0.00063026" iyz="-4.8147E-08" izz="0.00074925"/>
    </inertial>
  </link>
  <joint name="rslidar_joint" type="fixed">
    <parent link="box_link"/>
    <child link="rslidar"/>
    <origin rpy="0 0 0" xyz="0.37655 0 0.003"/>
  </joint>
  <!-- ════════════════════════════════════════════════════════════════════
       2. Xsens MTi IMU (mounted on base_link)
       Approximate placement; refine when validating against bag data.
       ════════════════════════════════════════════════════════════════════ -->
  <link name="imu_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.035 0.057 0.022"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.035 0.057 0.022"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.5554166666666668e-05" ixy="0" ixz="0" iyy="7.120833333333334e-06" iyz="0" izz="1.864166666666667e-05"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0.32 0 0.18"/>
  </joint>
  <!-- ════════════════════════════════════════════════════════════════════
       3. Intel RealSense D435 on xArm6 EE
       Static offset from link_eef per real robot calibration:
       xyz = 0 0 0.06   rpy = 0 -1.57 3.14  (from bringup_minimal.launch)
       ════════════════════════════════════════════════════════════════════ -->
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="5.235e-05" ixy="0" ixz="0" iyy="7.5e-06" iyz="0" izz="5.235e-05"/>
    </inertial>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="link_eef"/>
    <child link="camera_link"/>
    <origin rpy="0 -1.57 3.14" xyz="0 0 0.06"/>
  </joint>
  <!-- Optical frames following REP-103 (Z forward, X right, Y down) -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0"/>
  </joint>
</robot>
