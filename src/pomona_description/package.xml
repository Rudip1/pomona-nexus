<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pomona_description</name>
  <version>0.1.0</version>
  <description>
    Pomona robot description. URDF/xacro + meshes for the AgileX Scout V2
    mobile base, UFactory xArm6 manipulator, DH Robotics AG95 gripper, and
    on-board sensors (Intel RealSense D435, Robosense LiDAR, Xsens IMU).
    Shared by pomona_gazebo (sim) and pomona_bringup (real robot).
  </description>

  <maintainer email="Rudip1@users.noreply.github.com">Pravin Oli</maintainer>
  <author>Pravin Oli</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
