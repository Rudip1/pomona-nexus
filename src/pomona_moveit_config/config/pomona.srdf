  SRDF stub for Pomona MoveIt 2.

  Groups:
    arm                 — xArm6 (joint1..joint6)
    gripper             — AG95 finger_joint (with mimics)
    arm_with_gripper    — both, for full IK

  TODO  fill in disable_collisions pairs (run MoveIt Setup Assistant against
  pomona_description/urdf/xacro/pomona.xacro to auto-populate the ACM).
-->
<robot name="pomona">

  <group name="arm">
    <joint name="joint1"/>
    <joint name="joint2"/>
    <joint name="joint3"/>
    <joint name="joint4"/>
    <joint name="joint5"/>
    <joint name="joint6"/>
  </group>

  <group name="gripper">
    <joint name="finger_joint"/>
  </group>

  <group name="arm_with_gripper">
    <group name="arm"/>
    <group name="gripper"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="finger_joint" value="0.0"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="finger_joint" value="0.6524"/>
  </group_state>

  <end_effector name="ag95" parent_link="link_eef" group="gripper"/>

  <!-- TODO  disable_collisions tags (filled by MoveIt Setup Assistant) -->

</robot>
