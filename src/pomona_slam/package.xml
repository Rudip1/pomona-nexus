<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pomona_slam</name>
  <version>0.1.0</version>
  <description>
    SLAM Toolbox configuration for Pomona. Online async mapping +
    pure localization (against a saved map). Works against sim or real —
    toggle with use_sim_time arg.
  </description>

  <maintainer email="Rudip1@users.noreply.github.com">Pravin Oli</maintainer>
  <author>Pravin Oli</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
