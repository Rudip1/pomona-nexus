  TODO  grapevine world for Pomona greenhouse picking.

  Add greenhouse structure, grapevine models, lighting, and obstacles here.
  For now this is an empty placeholder that loads the same baseline as
  empty_world.world — it boots cleanly so the launch can be tested early.
-->
<sdf version="1.6">
  <world name="grapevine">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene><shadows>false</shadows></scene>
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
  </world>
</sdf>
