<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pomona_gazebo</name>
  <version>0.1.0</version>
  <description>
    Gazebo Classic 11 simulation package for Pomona.
    Provides launch files + worlds + SDF models for empty_world and four
    greenhouse-themed worlds (strawberry, grapevine, apple orchard,
    mushroom greenhouse). URDF and meshes live in pomona_description.
  </description>

  <maintainer email="Rudip1@users.noreply.github.com">Pravin Oli</maintainer>
  <author>Pravin Oli</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pomona_description</depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rqt_robot_steering</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/share/${name}/models"/>
  </export>
</package>
