# ── colcon build outputs ──────────────────────────────────────────────────────
build/
install/
log/

# ── python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# ── editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── MATLAB autosave ───────────────────────────────────────────────────────────
*.asv

# ── ROS / Gazebo runtime artifacts ────────────────────────────────────────────
*.bag
*.db3
*.mcap
core

# ── screen recordings (too heavy for git; commit a trimmed .gif in media/) ────
*.webm
*.mp4
*.mov
*.mkv
*.avi

# ── archives ──────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz
*.7z

# ── Blender backups / binary exports ──────────────────────────────────────────
*.blend1
*.glb

# ── goldmines: reference-only, NOT version controlled ────────────────────────
# Read-only ROS1 source + robot dumps + downloaded sim assets (~4 GB).
# Keep locally for reference; never commit the whole folder.
goldmines/

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── third-party plant assets (not redistributable; regenerate locally) ───────
# Strawberry meshes/textures are derived from a BlenderKit model; see
# cad_assets_studio/strawberry/README.md for how to rebuild them.
cad_assets_studio/strawberry/source/
cad_assets_studio/strawberry/extracted/
cad_assets_studio/strawberry/meshes/
cad_assets_studio/strawberry/variants/
cad_assets_studio/strawberry/textures/
cad_assets_studio/strawberry/checks/
src/pomona_gazebo/models/strawberry/*/meshes/
src/pomona_gazebo/models/strawberry/*/textures/
